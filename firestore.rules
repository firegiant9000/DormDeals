rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Listings: anyone can read active; only owner can write/delete their doc
    match /listings/{listingId} {
      allow read: if resource.data.status == 'active' || (isSignedIn() && request.auth.uid == resource.data.ownerId);
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.ownerId;
    }

    // Per-user subcollections
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid;

      match /{sub=cart|favorites}/{doc} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
