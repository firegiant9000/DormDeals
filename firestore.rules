rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function authed() { return request.auth != null; }
    function isOwnerOf(doc) { return authed() && request.auth.uid == doc.data.ownerId; }
    function isPathOwner(uid) { return authed() && request.auth.uid == uid; }

    // Public listings (readable by everyone), write by owner only
    match /listings/{listingId} {
      allow get, list : if true;
      allow create: if authed() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwnerOf(resource);

      // Required fields & types
      allow create, update: if
        request.resource.data.keys().hasAll(['ownerId','title','price','category','condition','status','createdAt','imageUrls']) &&
        request.resource.data.price is number &&
        request.resource.data.imageUrls is list &&
        request.resource.data.status in ['active','sold','hidden'];
    }

    // Per-user cart
    match /users/{uid}/cart/{itemId} {
      allow read, write: if isPathOwner(uid);
    }

    // Per-user favorites
    match /users/{uid}/favorites/{listingId} {
      allow read, write: if isPathOwner(uid);
    }

    // Messages (optional — keep narrow)
    match /users/{uid}/threads/{threadId} {
      allow read, write: if isPathOwner(uid);
    }
  }
}
