# DormDeal Environment Variables Example
# Copy this file to .env and fill in your actual values

# ===========================================
# REQUIRED ENVIRONMENT VARIABLES
# ===========================================

# Firebase Configuration (REQUIRED)
# Get these values from your Firebase project settings
# Go to: Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Server Configuration
PORT=3000
NODE_ENV=development

# Note: This application uses Firebase (Auth + Firestore) for all data storage.
# No PostgreSQL database is required.

# ===========================================
# OPTIONAL ENVIRONMENT VARIABLES
# ===========================================

# Development/Testing (Optional)
# Set to "true" to use mock data instead of Firestore
# Useful for offline development or CI/CD testing
VITE_USE_MOCKS=false

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=noreply@dormdeal.com

# File Upload & Storage (Optional)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# External Services (Optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Monitoring (Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===========================================
# NOTES
# ===========================================
# 1. Never commit the actual .env file to version control
# 2. Add .env to your .gitignore file
# 3. Use strong, unique secrets for production
# 4. Rotate secrets regularly
# 5. Use different secrets for different environments