# Environment Configuration for DormDeals
# Copy this file to .env and fill in your actual values

# Application Environment
NODE_ENV=production
VITE_APP_ENV=production

# API Configuration
VITE_API_BASE_URL=https://your-api-domain.com/api
VITE_API_TIMEOUT=10000

# Authentication & Security
VITE_JWT_SECRET=your-jwt-secret-key
VITE_ENCRYPTION_KEY=your-encryption-key

# Database Configuration (if using client-side database)
VITE_DATABASE_URL=your-database-connection-string
VITE_DATABASE_NAME=dormdeals

# External Services
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id

# Email Configuration
VITE_EMAIL_SERVICE_API_KEY=your-email-service-api-key
VITE_EMAIL_FROM=noreply@dormdeals.com

# File Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_MAINTENANCE_MODE=false

# Social Media Integration
VITE_FACEBOOK_APP_ID=your-facebook-app-id
VITE_TWITTER_API_KEY=your-twitter-api-key

# Notification Configuration
VITE_PUSH_NOTIFICATION_KEY=your-push-notification-key
VITE_WEBSOCKET_URL=wss://your-websocket-domain.com

# Analytics
VITE_GOOGLE_ANALYTICS_ID=your-google-analytics-id
VITE_MIXPANEL_TOKEN=your-mixpanel-token

# Rate Limiting
VITE_RATE_LIMIT_REQUESTS=100
VITE_RATE_LIMIT_WINDOW=900000

# CORS Configuration
VITE_ALLOWED_ORIGINS=https://dormdeals.com,https://www.dormdeals.com

# Cache Configuration
VITE_CACHE_TTL=3600000
VITE_CACHE_MAX_SIZE=100

# Logging
VITE_LOG_LEVEL=info
VITE_ENABLE_CONSOLE_LOGS=false

# Development/Testing
VITE_MOCK_API=false
VITE_TEST_MODE=false
