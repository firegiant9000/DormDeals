# DormDeals environment variables — copy to .env and fill in real values.
# Only the variables the app actually reads are listed here.
# Never commit your real .env (it is gitignored).

# ===========================================
# Firebase (client) — REQUIRED
# Firebase Console > Project Settings > General > Your apps > Web app
# ===========================================
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional — only if your project has Analytics enabled.
# Required to emit funnel events (listing_view, search, etc.). Without it,
# analytics is fully inert. See docs/analytics.md.
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ===========================================
# Observability — OPTIONAL
# ===========================================
# Sentry error tracking. Without a DSN, Sentry is fully inert (no network).
# Sentry Console > Project > Settings > Client Keys (DSN). Free tier: 5k events/mo.
VITE_SENTRY_DSN=

# ===========================================
# App flags — OPTIONAL
# ===========================================
# Comma-separated tester UIDs allowed to use validate-only listing mode.
# Leave blank in normal use. Example: abcd123,efgh456
VITE_VALIDATE_ONLY_ALLOWLIST=

