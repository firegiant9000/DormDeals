rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    function authed() { return request.auth != null; }

    // Listings images live under listings/{uid}/{listingId}/{filename}
    match /listings/{uid}/{listingId}/{file=**} {
      allow read: if true; // public images
      allow write: if authed() && request.auth.uid == uid; // create/update/delete by owner
      // Optional: enforce content type
      allow write: if request.resource.contentType.matches('image/.*') && authed() && request.auth.uid == uid;
    }
  }
}
